[Unit]
Description=Watchdog for restarting unhealthy docker containers
After=docker.service
Wants=docker.service
Requires=docker.socket
# Start rate-limit belongs in [Unit] (ignored in [Service] on systemd v229+).
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=notify
ExecStart=/opt/docker-watchdog/venv/bin/python /usr/local/bin/docker-watchdog.py
# docker 7.2 follows the active CLI context unless DOCKER_HOST is set; the watchdog must reach the local daemon.
Environment=DOCKER_HOST=unix:///var/run/docker.sock
TimeoutStartSec=5s
RestartSec=600s
Restart=always

[Install]
WantedBy=multi-user.target
